source("C:/Users/20100/Downloads/jumana_bioinfolab7.R")
library(ggplot2)
set.seed(123)
bio_data <- data.frame(
Condition = rep(c("Cancer", "Control"), each = 20),
GeneExpression = c(rnorm(20, 8, 1.5), rnorm(20, 6, 1)),
ProteinLevel = c(rnorm(20, 60, 8), rnorm(20, 50, 7)))
head(bio_data)
b<-ggplot(bio_data, aes(x = GeneExpression, y = ProteinLevel))
b + geom_point(aes(shape = Condition, color =
Condition)) +
scale_color_manual(values = c("#00AFBB","#FC4E07")) +
labs(title = "Gene Expression vs Protein Level",
x = "Gene Expression(log2)",
y = "Protein Concentration(μg/mL)")
a <- ggplot(bio_data, aes(x = ProteinLevel))
a + geom_histogram(bins = 30, color = "black", fill =
"lightblue") +
labs(title = "Distribution of Protein Concentration",
x = "Protein Concentration (µg/mL)",
y = "Number of Samples")
ggplot(bio_data, aes(sample = ProteinLevel)) +
stat_qq(aes(color = Condition)) +
scale_color_manual(values = c("#00AFBB",  "#E7B800")) +
labs(title = "QQ Plot of Protein Concentration by
Condition")
ggplot(bio_data, aes(x = Condition, y = ProteinLevel, fill = Condition)) +
geom_boxplot(alpha = 0.7) + geom_jitter(width = 0.1, alpha = 0.6) +
scale_fill_manual(values = c("#FC4E07", "#00AFBB")) +
theme_bw()
library(ggplot2)
set.seed(123)
bio_data <- data.frame(
Condition = rep(c("Cancer", "Control"), each = 20),
GeneExpression = c(rnorm(20, 8, 1.5), rnorm(20, 6, 1)),
ProteinLevel = c(rnorm(20, 60, 8), rnorm(20, 50, 7))
)
head(bio_data)
# ============================
# 1) SCATTER PLOT
# Interpretation:
# This scatter plot shows the relationship between gene expression and protein level.
# Cancer samples cluster at higher gene expression and protein values than controls.
# There appears to be a positive association: higher gene expression corresponds
# to higher protein concentration. The color separation indicates clear differences
# between Cancer and Control groups.
# ============================
b <- ggplot(bio_data, aes(x = GeneExpression, y = ProteinLevel))
b + geom_point(aes(shape = Condition, color = Condition)) +
scale_color_manual(values = c("#00AFBB", "#FC4E07")) +
labs(title = "Gene Expression vs Protein Level",
x = "Gene Expression (log2)",
y = "Protein Concentration (μg/mL)")
# ============================
# 2) HISTOGRAM
# Interpretation:
# This histogram shows the overall distribution of protein concentration.
# The distribution is roughly bell-shaped but wide because it contains two groups
# with different means (Cancer ≈ 60, Control ≈ 50). Most values fall between 45–65 μg/mL.
# This plot provides an overview of variability in protein levels across all samples.
# ============================
a <- ggplot(bio_data, aes(x = ProteinLevel))
a + geom_histogram(bins = 30, color = "black", fill = "lightblue") +
labs(title = "Distribution of Protein Concentration",
x = "Protein Concentration (µg/mL)",
y = "Number of Samples")
# ============================
# 3) QQ PLOT
# Interpretation:
# This QQ plot compares protein levels in each condition to a theoretical normal distribution.
# Points falling near the line indicate normality. Both Cancer and Control groups follow
# the diagonal closely, meaning protein levels are approximately normally distributed.
# This supports using parametric tests like the t-test.
# ============================
ggplot(bio_data, aes(sample = ProteinLevel)) +
stat_qq(aes(color = Condition)) +
scale_color_manual(values = c("#00AFBB", "#E7B800")) +
labs(title = "QQ Plot of Protein Concentration by Condition")
# ============================
# 4) BOXPLOT + JITTER
# Interpretation:
# This boxplot compares protein levels between Cancer and Control groups.
# The Cancer group has a clearly higher median and overall distribution than the Control group,
# with minimal overlap. The jittered points show individual samples and confirm the separation.
# This indicates a strong biological difference in protein concentration between conditions.
# ============================
ggplot(bio_data, aes(x = Condition, y = ProteinLevel, fill = Condition)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.1, alpha = 0.6) +
scale_fill_manual(values = c("#FC4E07", "#00AFBB")) +
theme_bw()
